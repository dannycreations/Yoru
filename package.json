{
	"name": "yoru",
	"version": "3.0.0",
	"main": "dist/main.js",
	"author": "dannycreations",
	"license": "GPL",
	"private": true,
	"scripts": {
		"start:pm2": "pm2 start . --stop-exit-codes 0",
		"start:watch": "npm run clean && tsx watch src/main.ts",
		"start:debug": "npm run build && node --inspect-brk .",
		"build": "npm run clean && tsc",
		"clean": "npx rimraf -g \"*.tsbuildinfo\" \"dist\"",
		"clean:nodefiles": "npx rimraf -g \"*-lock*\" \"node_modules\"",
		"update": "npx npm-check-updates -u -x discord.js,@types/node"
	},
	"dependencies": {
		"@sapphire/discord.js-utilities": "^7.3.3",
		"@sapphire/framework": "^5.3.6",
		"@sapphire/plugin-editable-commands": "^4.0.4",
		"@vegapunk/drizzle-orm": "^1.0.23",
		"@vegapunk/logger": "^1.0.25",
		"@vegapunk/request": "^1.0.39",
		"@vegapunk/struct": "^1.0.12",
		"@vegapunk/utilities": "^1.0.64",
		"clashofclans.js": "^3.3.22",
		"discord.js": "14.x",
		"dotenv": "^17.2.1"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.5.1",
		"@sapphire/ts-config": "^5.0.1",
		"@types/node": "22.x",
		"drizzle-kit": "^0.31.4",
		"prettier": "^3.6.2",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.14.0"
}
