{
  "name": "yoru",
  "version": "4.0.0",
  "main": "dist/main.js",
  "author": "dannycreations",
  "license": "GPL",
  "private": true,
  "scripts": {
    "start:watch": "npm run clean && tsx watch src/main.ts",
    "start:debug": "npm run build && node --inspect-brk .",
    "build": "npm run clean && tsc",
    "check": "npm run format && tsc --noEmit",
    "test": "vitest",
    "format": "prettier --write .",
    "clean": "rimraf -g \"*.tsbuildinfo\" \"dist\"",
    "clean:node": "rimraf -g \"*-lock*\" \"node_modules\"",
    "update": "npm-check-updates -u -x discord.js,got,@types/node",
    "prepare": "husky && effect-language-service patch"
  },
  "dependencies": {
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/framework": "^5.5.0",
    "@vegapunk/utilities": "^1.0.79",
    "better-sqlite3": "^12.10.0",
    "clashofclans.js": "^4.0.5",
    "discord.js": "14.x",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "got": "11.x",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "user-agents": "^2.1.75",
    "vitest": "^4.1.7"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/vitest": "^0.29.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sapphire/ts-config": "^5.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.x",
    "@types/user-agents": "^1.0.4",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "npm-check-updates": "^22.2.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.5.0"
}
