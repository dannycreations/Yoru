{
  "name": "yoru",
  "version": "4.0.0",
  "main": "dist/main.js",
  "author": "dannycreations",
  "license": "GPL",
  "type": "module",
  "private": true,
  "scripts": {
    "start:watch": "npm run clean && tsx watch src/main.ts",
    "start:debug": "npm run build && node --inspect-brk .",
    "build": "npm run clean && tsc",
    "check": "npm run format && tsc --noEmit",
    "test": "npm run check && vitest run",
    "format": "prettier --write .",
    "clean": "rimraf -g \"*.tsbuildinfo\" \"dist\"",
    "clean:node": "rimraf -g \"*-lock*\" \"node_modules\"",
    "update": "npm-check-updates -u -x discord.js,got,@types/node,pnpm",
    "postinstall": "node scripts/build-sqlite.js",
    "prepare": "husky && effect-tsgo patch"
  },
  "dependencies": {
    "@sapphire/discord.js-utilities": "^8.0.0",
    "@sapphire/framework": "^5.5.1",
    "@vegapunk/utilities": "^1.0.79",
    "better-sqlite3": "^13.2.0",
    "clashofclans.js": "^5.1.15",
    "discord.js": "14.x",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.1.4",
    "got": "11.x",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "user-agents": "^2.1.246",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.70.0",
    "@effect/vitest": "^4.1.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sapphire/ts-config": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.x",
    "@types/user-agents": "^1.0.4",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.28.2"
}
