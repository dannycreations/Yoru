{
  "name": "yoru",
  "version": "4.0.0",
  "main": "dist/main.js",
  "author": "dannycreations",
  "license": "GPL",
  "private": true,
  "scripts": {
    "start:watch": "npm run clean && tsx watch src/main.ts",
    "start:debug": "npm run build && node --inspect-brk .",
    "build": "npm run clean && tsc",
    "check": "npm run format && tsc --noEmit",
    "test": "vitest",
    "format": "prettier --write .",
    "clean": "rimraf -g \"*.tsbuildinfo\" \"dist\"",
    "clean:node": "rimraf -g \"*-lock*\" \"node_modules\"",
    "update": "npm-check-updates -u -x discord.js,got,@types/node",
    "prepare": "husky"
  },
  "dependencies": {
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/framework": "^5.5.0",
    "@vegapunk/utilities": "^1.0.79",
    "better-sqlite3": "^12.6.2",
    "clashofclans.js": "^3.5.1",
    "discord.js": "14.x",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.15",
    "got": "11.x",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "user-agents": "^1.1.669",
    "vitest": "^4.0.18"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@sapphire/ts-config": "^5.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.x",
    "@types/user-agents": "^1.0.4",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "npm-check-updates": "^19.3.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.1"
}
