{
  "name": "yoru",
  "version": "3.0.0",
  "main": "dist/main.js",
  "author": "dannycreations",
  "license": "GPL",
  "private": true,
  "scripts": {
    "start:watch": "npm run clean && tsx watch src/main.ts",
    "start:debug": "npm run build && node --inspect-brk .",
    "build": "npm run clean && tsc",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "pnpx rimraf -g \"*.tsbuildinfo\" \"dist\"",
    "clean:node": "pnpx rimraf -g \"*-lock*\" \"node_modules\"",
    "update": "pnpx npm-check-updates -u -x discord.js,@types/node",
    "prepare": "husky"
  },
  "dependencies": {
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/plugin-editable-commands": "^4.0.4",
    "@vegapunk/drizzle-orm": "^1.0.29",
    "@vegapunk/logger": "^1.0.31",
    "@vegapunk/request": "^1.0.44",
    "@vegapunk/struct": "^1.0.17",
    "@vegapunk/utilities": "^1.0.78",
    "clashofclans.js": "^3.5.1",
    "discord.js": "14.x",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@sapphire/ts-config": "^5.0.3",
    "@types/node": "22.x",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.27.0"
}
